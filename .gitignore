# Per-user Claude Code settings stay out of the repo — EXCEPT the engine
# workflow, which is the shareable entrypoint and must ship with a clone.
.claude/*
!.claude/workflows/
.claude/workflows/*
!.claude/workflows/research-attack.js

# Downloaded third-party software (not project state)
external/

# Methodology paper draft (root-level only; problems/*/paper/ stay tracked)
/paper/

# Crawler-emitted file that's redundant with problems.json
data/urls.txt

# Vendored third-party clones (not committed; document clone command in project README)
problems/pebbling_cartesian_product/external/Graph_Pebbling/
problems/earth_moon_problem/external/sat-modulo-symmetries/

# Downloaded third-party reference material (arXiv PDFs + LaTeX/source); never
# committed, matching the repo's existing 0-tracked-Refs convention. Put your own
# notes in docs/, not Refs/, if you want them tracked.
Refs/

# Pebbling project temp artifacts (intermediate solver dumps)
problems/pebbling_cartesian_product/data/pebbling_product/_tmp_*.json

